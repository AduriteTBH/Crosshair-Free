                                <Border x:Name="CardColorCyan" Style="{StaticResource HoverColorCardStyle}" Height="78" Background="#00E5FF" BorderBrush="Transparent" BorderThickness="2" CornerRadius="8" Cursor="Hand" MouseLeftButtonUp="Color_Cyan">
                                    <TextBlock Text="Cyan" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="IndicatorColorCyan" Height="2" Background="#0084FF" Margin="6,4,6,0" Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- WHITE CARD -->
                            <StackPanel Grid.Column="2" Margin="4,0,3,0">
                                <Border x:Name="CardColorWhite" Style="{StaticResource HoverColorCardStyle}" Height="78" Background="#FFFFFF" BorderBrush="Transparent" BorderThickness="2" CornerRadius="8" Cursor="Hand" MouseLeftButtonUp="Color_White">
                                    <TextBlock Text="White" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="IndicatorColorWhite" Height="2" Background="#0084FF" Margin="6,4,6,0" Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- RED CARD -->
                            <StackPanel Grid.Column="3" Margin="5,0,2,0">
                                <Border x:Name="CardColorRed" Style="{StaticResource HoverColorCardStyle}" Height="78" Background="#FF2600" BorderBrush="Transparent" BorderThickness="2" CornerRadius="8" Cursor="Hand" MouseLeftButtonUp="Color_Red">
                                    <TextBlock Text="Red" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="IndicatorColorRed" Height="2" Background="#0084FF" Margin="6,4,6,0" Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- COLOR PICKER (RAINBOW GRADIENT CARD) -->
                            <StackPanel Grid.Column="4" Margin="5,0,0,0">
                                <Border x:Name="CardColorPicker" Style="{StaticResource HoverColorCardStyle}" Height="78" BorderBrush="Transparent" BorderThickness="2" CornerRadius="8" Cursor="Hand" MouseLeftButtonUp="Color_Picker">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF0000" Offset="0.0"/>
                                            <GradientStop Color="#FF7700" Offset="0.15"/>
                                            <GradientStop Color="#FFEE00" Offset="0.30"/>
                                            <GradientStop Color="#00FF66" Offset="0.45"/>
                                            <GradientStop Color="#00E5FF" Offset="0.60"/>
                                            <GradientStop Color="#0044FF" Offset="0.75"/>
                                            <GradientStop Color="#9900FF" Offset="0.90"/>
                                            <GradientStop Color="#FF00AA" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Border Background="#25000000" CornerRadius="6"/>
                                        <TextBlock Text="Color Picker" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#000000" Opacity="0.8"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <Border x:Name="IndicatorColorPicker" Height="2" Background="#0084FF" Margin="6,4,6,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

    </Grid>
</Window>
